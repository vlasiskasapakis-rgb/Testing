<video id="procVideo" playsinline preload="auto"></video>

<script>
(function () {
  'use strict';
  var $ = function(id) { return document.getElementById(id); };

  window.hardwareHeading = null;
  window.currentEditIndex = -1;

  window.addEventListener('deviceorientation', function(e) {
    if (e.webkitCompassHeading !== undefined) {
      window.hardwareHeading = e.webkitCompassHeading;
    }
  }, true);

  window.addEventListener('deviceorientationabsolute', function(e) {
    if (e.alpha !== null) {
      var alpha = e.alpha ? e.alpha * Math.PI / 180 : 0;
      var beta = e.beta ? e.beta * Math.PI / 180 : 0;
      var gamma = e.gamma ? e.gamma * Math.PI / 180 : 0;
      var cA = Math.cos(alpha), sA = Math.sin(alpha);
      var cB = Math.cos(beta), sB = Math.sin(beta);
      var cG = Math.cos(gamma), sG = Math.sin(gamma);
      var vX = -cA * sG - sA * sB * cG;
      var vY = -sA * sG + cA * sB * cG;
      var heading = Math.atan2(vX, vY) * 180 / Math.PI;
      if (heading < 0) heading += 360;
      window.hardwareHeading = heading;
    }
  }, true);

  // ==========================================
  // 1. AR & ΧΑΡΤΗΣ
  // ==========================================
  var STORIES = [
    { id: 'sapfous', title: 'Πλατεία Σαπφούς', subtitle: 'Κέντρο', lat: 39.106668, lon: 26.557367, radius: 40, text: 'Η κεντρική πλατεία της Μυτιλήνης δίπλα στο λιμάνι.' },
    { id: 'therapon', title: 'Άγιος Θεράπων', subtitle: 'Ερμού', lat: 39.105126, lon: 26.554749, radius: 35, text: 'Η μεγαλύτερη εκκλησία της πόλης με τον εντυπωσιακό τρούλο.' },
    { id: 'mikrasiatisa', title: 'Μικρασιάτισσα Μάνα', subtitle: 'Επάνω Σκάλα', lat: 39.112350, lon: 26.557179, radius: 35, text: 'Το μνημείο που είναι αφιερωμένο στη Μικρασιάτισσα Μάνα.' },
    { id: 'geni_tzami', title: 'Γενί Τζαμί', subtitle: 'Επάνω Σκάλα', lat: 39.110375, lon: 26.557753, radius: 35, text: 'Το ιστορικό οθωμανικό τέμενος της Μυτιλήνης.' },
    { id: 'agios_eudokimos', title: 'Άγιος Ευδόκιμος', subtitle: 'Ιστορικό Κέντρο', lat: 39.109996, lon: 26.556444, radius: 35, text: 'Ιστορικός ναός της πόλης.' },
    { id: 'agalma', title: 'Άγαλμα Ελευθερίας', subtitle: 'Λιμάνι', lat: 39.105871, lon: 26.563128, radius: 40, text: 'Το εμβληματικό άγαλμα που δεσπόζει στην είσοδο του λιμανιού.' },
    { id: 'kastro', title: 'Κάστρο Μυτιλήνης', subtitle: 'Βόρεια Πλευρά', lat: 39.111665, lon: 26.562324, radius: 50, text: 'Ένα από τα μεγαλύτερα κάστρα της Μεσογείου.' }
  ];

  var MIN_DIST = 2;
  var me = null, map = null, meMarker = null, accCircle = null, followMe = true;
  window.currentHeading = null;

  var arPaused = false;
  function setAR(active) {
    var sc = document.querySelector('a-scene');
    if (!sc) return;
    if (!active && !arPaused) { try { sc.pause(); } catch(e){} arPaused = true; document.body.classList.add('editing'); }
    else if (active && arPaused) { try { sc.play(); } catch(e){} arPaused = false; document.body.classList.remove('editing'); }
  }

  function distanceMetres(lat1, lon1, lat2, lon2) {
    var R = 6371000, rad = function(d) { return d * Math.PI / 180; };
    var a = Math.sin(rad(lat2 - lat1)/2) * Math.sin(rad(lat2 - lat1)/2) + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(rad(lon2 - lon1)/2) * Math.sin(rad(lon2 - lon1)/2);
    return 2 * R * Math.asin(Math.sqrt(a));
  }

  AFRAME.registerComponent('hud-compass', {
    tick: function () {
      if (window.hardwareHeading === null) return;
      var h = window.hardwareHeading;
      window.currentHeading = h;
      if (this.displayHeading === undefined) this.displayHeading = h;
      var diff = h - (this.displayHeading % 360);
      if (diff > 180) diff -= 360; else if (diff < -180) diff += 360;
      this.displayHeading += diff * 0.1;
      var needle = document.querySelector('#compass .needle');
      var degOut = document.querySelector('#compass .deg');
      if (needle) {
        needle.style.transform = 'rotate(' + (-this.displayHeading) + 'deg)';
        degOut.textContent = Math.round(((this.displayHeading % 360) + 360) % 360) + '°';
      }
      applyHeadingToDot();
      updateHTMLMarkersPosition();
    }
  });

  function openStorySheet(s) {
    $('sheetTitle').textContent = s.title;
    $('sheetSub').textContent = s.subtitle;
    $('sheetBody').textContent = s.text;
    $('infoSheet').classList.add('on');
  }

  function buildScene() {
    var container = $('ar-overlay-container');
    container.innerHTML = '';
    STORIES.forEach(s => {
      var div = document.createElement('div');
      div.className = 'ar-html-marker';
      div.id = 'html-marker-' + s.id;
      div.style.display = 'none';
      div.innerHTML = `
        <div class="closest-badge">📍 Πιο κοντά</div>
        <span class="m-title"><span id="lock-${s.id}">🔒 </span>${s.title}</span>
        <span class="m-sub">${s.subtitle}</span>
        <span class="m-dist" id="dist-${s.id}">Υπολογισμός...</span>
      `;
      div.onclick = () => {
        if (me) {
          var currentD = distanceMetres(me.lat, me.lon, s.lat, s.lon);
          if (currentD > 100) {
            alert('Είσαι ' + Math.round(currentD) + 'm μακριά.\n\nΠλησίασε κάτω από 100m για να ξεκλειδώσεις αυτήν την ιστορία!');
            return;
          }
        }
        openStorySheet(s);
      };
      container.appendChild(div);
    });

    var scene = document.createElement('a-scene');
    scene.setAttribute('hud-compass', '');
    scene.setAttribute('vr-mode-ui', 'enabled: false');
    scene.setAttribute('arjs', 'sourceType: webcam; videoTexture: true; debugUIEnabled: false');
    scene.innerHTML = `<a-camera id="cam" gps-new-camera="gpsMinDistance: ${MIN_DIST}"></a-camera>`;
    document.body.appendChild(scene);
  }

  function updateHTMLMarkersPosition() {
    if (!me || window.currentHeading === null) return;
    if (!document.querySelector('#cam')) return;

    var calculatedItems = [];
    var minDist = Infinity, closestId = null;

    STORIES.forEach(s => {
      s.d = distanceMetres(me.lat, me.lon, s.lat, s.lon);
      if (s.d < minDist) { minDist = s.d; closestId = s.id; }
    });

    STORIES.forEach(s => {
      var markerEl = $('html-marker-' + s.id);
      if (!markerEl) return;

      var distStr = s.d >= 1000 ? (s.d/1000).toFixed(1) + ' km' : Math.round(s.d) + ' m';
      $('dist-' + s.id).textContent = 'Απόσταση: ' + distStr;

      markerEl.classList.toggle('closest', s.id === closestId);

      if (s.d > 100) {
        markerEl.classList.add('locked');
        $('lock-' + s.id).style.display = 'inline';
      } else {
        markerEl.classList.remove('locked');
        $('lock-' + s.id).style.display = 'none';
      }

      markerEl.style.zIndex = Math.max(1, 90 - Math.floor(s.d / 10));

      var rad = function(d) { return d * Math.PI / 180; };
      var dLon = rad(s.lon - me.lon);
      var y = Math.sin(dLon) * Math.cos(rad(s.lat));
      var x = Math.cos(rad(me.lat)) * Math.sin(rad(s.lat)) - Math.sin(rad(me.lat)) * Math.cos(rad(s.lat)) * Math.cos(dLon);
      var bearing = (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;

      var angleDiff = bearing - window.currentHeading;
      while (angleDiff < -180) angleDiff += 360;
      while (angleDiff > 180) angleDiff -= 360;

      if (Math.abs(angleDiff) < 70) {
        var screenX = window.innerWidth / 2 + (angleDiff / 70) * (window.innerWidth / 2);
        calculatedItems.push({ el: markerEl, x: screenX });
      } else {
        markerEl.style.display = 'none';
      }
    });

    calculatedItems.sort((a, b) => a.x - b.x);
    var basePosY = window.innerHeight / 2, minSpacing = 130;

    for (var i = 0; i < calculatedItems.length; i++) {
      var item = calculatedItems[i];
      item.el.style.display = 'block';
      var targetY = basePosY;
      if (i > 0 && Math.abs(calculatedItems[i].x - calculatedItems[i - 1].x) < minSpacing) {
        targetY = basePosY + ((i % 2 === 0) ? -55 : 55);
      }
      item.el.style.left = item.x + 'px';
      item.el.style.top = targetY + 'px';
    }
  }

  function initMap() {
    map = L.map('map', {zoomControl: true, attributionControl: false}).setView([STORIES[0].lat, STORIES[0].lon], 16);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom: 19}).addTo(map);
    var markers = L.markerClusterGroup({ maxClusterRadius: 40, iconCreateFunction: c => L.divIcon({html: c.getChildCount(), className: 'map-cluster-dot', iconSize: [32, 32]}) });
    STORIES.forEach(s => {
      var m = L.marker([s.lat, s.lon], { icon: L.divIcon({html: '<div class="poi-dot"></div>', iconSize: [13, 13]}) }).on('click', () => openStorySheet(s));
      markers.addLayer(m);
    });
    map.addLayer(markers);
    map.on('dragstart', () => followMe = false);
  }

  function updateMap() {
    if(!map || !me) return;
    var ll = [me.lat, me.lon];
    if(!meMarker) {
      meMarker = L.marker(ll, { icon: L.divIcon({className: '', html: '<div class="me-wrap"><div class="me-rot unknown"><div class="me-cone"></div><div class="me-dot"></div></div></div>', iconSize: [56, 56], iconAnchor: [28, 28]}), zIndexOffset: 1000 }).addTo(map);
      accCircle = L.circle(ll, {radius: me.accuracy||0, color: '#F0C244'}).addTo(map);
    } else {
      meMarker.setLatLng(ll); accCircle.setLatLng(ll).setRadius(me.accuracy||0);
    }
    if(followMe) map.setView(ll, map.getZoom(), {animate: false});
  }

  var cachedRot = null, displayMapHeading = 0;
  function applyHeadingToDot() {
    if(!meMarker || window.currentHeading === null) return;
    if(!cachedRot) { var elm = meMarker.getElement(); if(elm) cachedRot = elm.querySelector('.me-rot'); }
    if(!cachedRot) return;
    cachedRot.classList.remove('unknown');
    var diff = window.currentHeading - (displayMapHeading % 360);
    if(diff > 180) diff -= 360; else if(diff < -180) diff += 360;
    displayMapHeading += diff;
    cachedRot.style.transform = `rotate(${displayMapHeading}deg)`;
  }

  $('handle').addEventListener('click', () => {
    $('drawer').classList.toggle('open'); document.body.classList.toggle('drawer-open');
    if(map) setTimeout(() => { map.invalidateSize(); updateMap(); }, 300);
  });
  $('closeInfoBtn').addEventListener('click', () => $('infoSheet').classList.remove('on'));

  function onPosition(pos) {
    me = { lat: pos.coords.latitude, lon: pos.coords.longitude, accuracy: pos.coords.accuracy };
    updateMap();
    $('status').textContent = `Ακρίβεια ${Math.round(me.accuracy)}m. ` + (window.currentHeading===null ? '' : `Πυξίδα ${Math.round(window.currentHeading)}°`);
    $('addBtn').classList.add('on');
    $('locDisplay').textContent = `${me.lat.toFixed(5)}, ${me.lon.toFixed(5)}`;

    var ranked = STORIES.map(s => ({s:s, d:distanceMetres(me.lat, me.lon, s.lat, s.lon)})).sort((a,b)=>a.d-b.d)[0];
    if(ranked) {
      var btn = $('nearest');
      btn.querySelector('.dist').textContent = (ranked.d <= ranked.s.radius) ? 'Είσαι εδώ' : `${Math.round(ranked.d)}m μακριά`;
      btn.querySelector('.name').textContent = ranked.s.title;
      btn.classList.add('on');
      btn.onclick = () => openStorySheet(ranked.s);
    }
  }

  $('startBtn').addEventListener('click', function() {
    this.disabled = true; this.textContent = 'Άνοιγμα κάμερας…';
    (window.DeviceOrientationEvent && typeof DeviceOrientationEvent.requestPermission === 'function' ? DeviceOrientationEvent.requestPermission() : Promise.resolve('granted'))
    .then(state => {
      if(state !== 'granted') throw new Error('Δεν δόθηκε άδεια.');
      buildScene(); $('gate').style.display = 'none'; $('hud').classList.add('on'); initMap();
      navigator.geolocation.watchPosition(onPosition, err => $('status').textContent = 'Σφάλμα GPS', {enableHighAccuracy: true, timeout: 10000});
    }).catch(e => { this.disabled = false; this.textContent = 'Δοκίμασε ξανά'; alert(e); });
  });

  // ==========================================
  // 2. EDITOR (μη καταστροφικός)
  // ==========================================
  // Κάθε στοιχείο: { originalFile, name, displayName, kind, meta, blob (τελικό ή null), outType }
  var MAX_IMAGE_W = 1600;
  var MAX_VIDEO_W = 640;
  var VIDEO_BITRATE = 1000000;
  var BRUSH_FRAC = 0.05, BRUSH_MIN = 24;

  var processedFiles = [];
  var currentFile = null;
  var currentObjectURL = null;
  var previewURLs = [];

  var canvas = $('imageCanvas'), ctx = canvas.getContext('2d', { alpha: false });
  var imgObj = null, isDrawing = false;
  var blurSrc = document.createElement('canvas');
  var imgStrokes = [];      // [[{x,y,r}, ...], ...] με κανονικοποιημένες συντεταγμένες
  var curStroke = null;

  var cachedVideoRanges = [];
  var cachedAudioRanges = [];

  function getKind(file) {
    var t = file.type || '';
    if (t.startsWith('image/')) return 'image';
    if (t.startsWith('video/')) return 'video';
    return 'audio';
  }

  function showProgress(on, msg, pct, title) {
    $('processingOverlay').style.display = on ? 'flex' : 'none';
    if (title != null) $('procTitle').textContent = title;
    if (msg != null) $('procMsg').textContent = msg;
    if (pct != null) $('procBarFill').style.width = Math.max(0, Math.min(100, pct)) + '%';
  }

  function waitForFiniteDuration(media) {
    return new Promise(function (resolve) {
      if (isFinite(media.duration) && media.duration > 0) { resolve(); return; }
      var done = false;
      function finish(force) {
        if (done) return;
        if (!force && !isFinite(media.duration)) return;
        done = true;
        media.removeEventListener('durationchange', onEv);
        media.removeEventListener('timeupdate', onEv);
        try { media.currentTime = 0; } catch (e) {}
        resolve();
      }
      function onEv() { finish(false); }
      media.addEventListener('durationchange', onEv);
      media.addEventListener('timeupdate', onEv);
      try { media.currentTime = 1e7; } catch (e) {}
      setTimeout(function () { finish(true); }, 3000);
    });
  }

  function inRanges(ranges, t, key) {
    for (var i = 0; i < ranges.length; i++) {
      var r = ranges[i];
      if ((!key || r[key]) && t >= r.s && t < r.e) return true;
    }
    return false;
  }

  function pickInterval(duration) {
    if (duration > 120) return 30;
    if (duration > 60) return 15;
    if (duration > 20) return 5;
    if (duration > 10) return 2;
    return 1;
  }

  // --- Θόλωμα με υποστήριξη iOS ---
  var _filterSupported = null;
  function supportsCanvasFilter() {
    if (_filterSupported !== null) return _filterSupported;
    try {
      var c = document.createElement('canvas');
      c.width = 5; c.height = 5;
      var x = c.getContext('2d');
      if (!('filter' in x)) return (_filterSupported = false);
      x.fillStyle = '#000'; x.fillRect(0, 0, 5, 5);
      x.filter = 'blur(2px)';
      x.fillStyle = '#fff'; x.fillRect(2, 2, 1, 1);
      var p = x.getImageData(1, 2, 1, 1).data;
      _filterSupported = p[0] > 0;
    } catch (e) { _filterSupported = false; }
    return _filterSupported;
  }

  function buildBlurSource(src, dst) {
    var w = src.width, h = src.height;
    dst.width = w; dst.height = h;
    var dctx = dst.getContext('2d');

    if (supportsCanvasFilter()) {
      dctx.filter = 'blur(16px)';
      dctx.drawImage(src, 0, 0);
      dctx.filter = 'none';
      return;
    }

    var target = Math.max(8, Math.round(w / 20));
    var steps = [], cur = src, cw = w, ch = h;
    while (cw / 2 >= target) {
      var c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(cw / 2));
      c.height = Math.max(1, Math.round(ch / 2));
      var cc = c.getContext('2d');
      cc.imageSmoothingEnabled = true;
      cc.imageSmoothingQuality = 'high';
      cc.drawImage(cur, 0, 0, c.width, c.height);
      steps.push(c);
      cur = c; cw = c.width; ch = c.height;
    }
    for (var i = steps.length - 2; i >= 0; i--) {
      var up = steps[i], uc = up.getContext('2d');
      uc.imageSmoothingEnabled = true;
      uc.imageSmoothingQuality = 'high';
      uc.clearRect(0, 0, up.width, up.height);
      uc.drawImage(cur, 0, 0, up.width, up.height);
      cur = up;
    }
    dctx.imageSmoothingEnabled = true;
    dctx.imageSmoothingQuality = 'high';
    dctx.drawImage(cur, 0, 0, w, h);
  }

  function blurDot(tctx, src, x, y, r) {
    tctx.save();
    tctx.beginPath(); tctx.arc(x, y, r, 0, Math.PI * 2); tctx.clip();
    tctx.drawImage(src, 0, 0);
    tctx.restore();
  }

  // Ζωγραφίζει όλες τις πινελιές σε έναν canvas μεγέθους w×h
  function paintStrokes(tctx, src, strokes, w, h) {
    strokes.forEach(function (group) {
      group.forEach(function (p) { blurDot(tctx, src, p.x * w, p.y * h, p.r * w); });
    });
  }

  function redrawImage() {
    if (!imgObj) return;
    ctx.drawImage(imgObj, 0, 0, canvas.width, canvas.height);
    paintStrokes(ctx, blurSrc, imgStrokes, canvas.width, canvas.height);
  }

  function loadImage(file) {
    return new Promise(function (resolve, reject) {
      var url = URL.createObjectURL(file);
      var im = new Image();
      im.onload = function () { URL.revokeObjectURL(url); resolve(im); };
      im.onerror = function () { URL.revokeObjectURL(url); reject(new Error('Αποτυχία φόρτωσης εικόνας.')); };
      im.src = url;
    });
  }

  // Τελική απόδοση εικόνας από το αρχικό αρχείο
  async function renderImageFinal(file, strokes) {
    var im = await loadImage(file);
    var k = Math.min(1, MAX_IMAGE_W / im.width);
    var c = document.createElement('canvas');
    c.width = Math.round(im.width * k);
    c.height = Math.round(im.height * k);
    var cctx = c.getContext('2d', { alpha: false });
    cctx.drawImage(im, 0, 0, c.width, c.height);
    if (strokes && strokes.length) {
      var bs = document.createElement('canvas');
      buildBlurSource(c, bs);
      paintStrokes(cctx, bs, strokes, c.width, c.height);
    }
    return await new Promise(function (res) { c.toBlob(res, 'image/jpeg', 0.82); });
  }

  // --- Timeline βίντεο ---
  function updateVideoTimeline() {
    cachedVideoRanges = readVideoRanges();
    applyVideoFx();

    var timeline = $('videoTimeline');
    timeline.innerHTML = '';
    var video = $('videoPreview');
    var duration = video.duration;
    if (!isFinite(duration) || duration <= 0) return;

    var gridCanvas = $('videoGridCanvas');
    var gctx = gridCanvas.getContext('2d');
    var dpr = window.devicePixelRatio || 1;
    var rect = gridCanvas.getBoundingClientRect();
    var width = rect.width || gridCanvas.parentElement.clientWidth || 300;
    var height = rect.height || 60;

    gridCanvas.width = width * dpr;
    gridCanvas.height = height * dpr;
    gctx.scale(dpr, dpr);
    gctx.clearRect(0, 0, width, height);

    var interval = pickInterval(duration);
    gctx.fillStyle = 'rgba(242, 237, 228, 0.8)';
    gctx.font = '10px monospace';
    gctx.textBaseline = 'top';
    var topOffset = 18;

    for (var t = 0; t <= duration; t += interval) {
      var x = (t / duration) * width;
      gctx.textAlign = x < 10 ? 'left' : (x > width - 15 ? 'right' : 'center');
      gctx.fillText(t + 's', x, 4);
      gctx.fillStyle = 'rgba(242, 237, 228, 0.15)';
      gctx.fillRect(x, topOffset, 1, height - topOffset);
      gctx.fillStyle = 'rgba(242, 237, 228, 0.8)';
    }

    document.querySelectorAll('#videoRangeList .range-item').forEach(function(row) {
      var s = parseFloat(row.querySelector('.r-start').value);
      var e = parseFloat(row.querySelector('.r-end').value);
      if (isNaN(s) || isNaN(e) || e <= s) return;
      var leftPct = Math.max(0, Math.min(100, (s / duration) * 100));
      var widthPct = Math.max(0, Math.min(100 - leftPct, ((e - s) / duration) * 100));
      ['blur', 'mute'].forEach(function (kind) {
        if (!row.querySelector('.r-' + kind).checked) return;
        var b = document.createElement('div');
        b.className = 'timeline-block ' + kind;
        b.style.left = leftPct + '%';
        b.style.width = widthPct + '%';
        b.style.top = topOffset + 'px';
        timeline.appendChild(b);
      });
    });
  }

