    if (!f) return;
    window.currentEditIndex = index;
    loadFileIntoEditor(f.originalFile, f.meta);   // πάντα από το αρχικό
  };

  function describeChanges(f) {
    if (f.kind === 'image') {
      var n = (f.meta.strokes || []).length;
      return n ? n + ' περιοχ' + (n === 1 ? 'ή' : 'ές') + ' θολώματος' : 'Χωρίς αλλαγές';
    }
    var r = (f.meta.ranges || []).length;
    return r ? r + ' σημεί' + (r === 1 ? 'ο' : 'α') + ' επεξεργασίας' : 'Χωρίς αλλαγές';
  }

  function hasChanges(f) {
    return f.kind === 'image' ? true : (f.meta.ranges || []).length > 0;
  }

  function updateMediaListUI() {
    var list = $('mediaList');
    if (processedFiles.length === 0) {
      list.innerHTML = '<p style="font-size:13px; color:#666; margin:0;">Δεν έχεις προσθέσει αρχεία ακόμα.</p>';
      return;
    }
    var html = '';
    processedFiles.forEach((f, i) => {
      var kb = Math.round(f.originalFile.size / 1024);
      var state = f.blob ? '✓ αποθηκευμένο' : '⏳ εκκρεμεί αποθήκευση';
      html += `<div class="media-list-item">
                 <div class="mi-text">
                   <span class="mi-name">${i+1}. ${f.displayName} <small style="color:#666">(${kb} KB)</small></span>
                   <span class="mi-changes">${describeChanges(f)} · ${state}</span>
                 </div>
                 <div style="flex-shrink:0;">
                   <button class="edit-media-btn" onclick="editFromUploadList(${i})" title="Επεξεργασία">✏️</button>
                   <button class="delete-media-btn" onclick="removeMedia(${i})" title="Διαγραφή">✕</button>
                 </div>
               </div>`;
    });
    list.innerHTML = html;
  }

  // --- Ολοκλήρωση ιστορίας ---
  $('finishStoryBtn').onclick = function() {
    var title = $('storyTitle').value.trim();
    if (!title) return alert("Βάλε έναν τίτλο για την ιστορία σου.");
    if (processedFiles.length === 0) return alert("Πρόσθεσε τουλάχιστον ένα αρχείο.");

    var pending = processedFiles.filter(f => !f.blob);
    var withEdits = processedFiles.filter(f => f.kind !== 'image' ? (f.meta.ranges || []).length : (f.meta.strokes || []).length).length;
    $('confirmSummary').textContent = processedFiles.length + ' αρχεία, ' + withEdits + ' με αλλαγές, ' + pending.length + ' προς αποθήκευση.';
    $('uploadSheet').classList.remove('on');
    $('confirmModal').classList.add('on');
  };

  $('confirmBackBtn').onclick = function () {
    $('confirmModal').classList.remove('on');
    $('uploadSheet').classList.add('on');
  };

  // Μόνιμο audio graph για το κρυφό procVideo (συνδέεται ΜΙΑ φορά)
  var procAudio = null;
  function getProcAudio() {
    if (procAudio) return procAudio;
    var actx = new (window.AudioContext || window.webkitAudioContext)();
    var src = actx.createMediaElementSource($('procVideo'));
    var gain = actx.createGain();
    src.connect(gain);
    gain.connect(actx.destination);
    procAudio = { ctx: actx, src: src, gain: gain };
    return procAudio;
  }

  $('confirmApplyBtn').onclick = function () {
    $('confirmModal').classList.remove('on');

    // Ξεκλείδωμα ήχου/βίντεο μέσα στο πάτημα (απαραίτητο στο iOS)
    var needsVideo = processedFiles.some(f => !f.blob && f.kind === 'video' && (f.meta.ranges || []).length);
    if (needsVideo) {
      try {
        var pa = getProcAudio();
        if (pa.ctx.state === 'suspended') pa.ctx.resume();
        var pv = $('procVideo');
        var firstVid = processedFiles.find(f => !f.blob && f.kind === 'video');
        var unlockUrl = URL.createObjectURL(firstVid.originalFile);
        pv.src = unlockUrl;
        var p = pv.play();
        if (p && p.then) p.then(() => pv.pause()).catch(() => {});
        setTimeout(() => URL.revokeObjectURL(unlockUrl), 5000);
      } catch (e) {}
    }

    applyAllEdits();
  };

  async function applyAllEdits() {
    var todo = processedFiles.map((f, i) => ({ f: f, i: i })).filter(x => !x.f.blob);
    var total = todo.length;

    try {
      for (var k = 0; k < todo.length; k++) {
        var f = todo[k].f;
        var head = 'Αρχείο ' + (k + 1) + ' από ' + total + ' · ' + f.displayName;
        var base = (k / total) * 100;
        var span = 100 / total;
        showProgress(true, head, base, 'Αποθήκευση αλλαγών…');

        if (f.kind === 'image') {
          f.blob = await renderImageFinal(f.originalFile, f.meta.strokes);
          f.outType = 'image/jpeg';
        }
        else if (f.kind === 'video') {
          var vr = f.meta.ranges || [];
          if (vr.length) {
            f.blob = await processVideoFile(f.originalFile, vr, function (pct, txt) {
              showProgress(true, head + ' · ' + txt, base + span * pct / 100);
            });
            f.outType = f.blob.type || 'video/webm';
          } else {
            f.blob = f.originalFile;
            f.outType = f.originalFile.type;
          }
        }
        else {
          var ar = f.meta.ranges || [];
          if (ar.length) {
            f.blob = await processAudioLocal(f.originalFile, ar);
            f.outType = 'audio/wav';
          } else {
            f.blob = f.originalFile;
            f.outType = f.originalFile.type || 'audio/mp4';
          }
        }
        showProgress(true, head, base + span);
      }
    } catch (e) {
      showProgress(false);
      updateMediaListUI();
      alert('Σφάλμα στην αποθήκευση: ' + (e && e.message ? e.message : e) + '\n\nΤα αρχικά αρχεία και οι ρυθμίσεις σου είναι ασφαλή. Δοκίμασε ξανά.');
      $('uploadSheet').classList.add('on');
      return;
    }

    showProgress(false);
    updateMediaListUI();
    showLocalPreview();
  }

  function showLocalPreview() {
    var container = $('localPreviewContainer');
    clearPreview();

    processedFiles.forEach((f, i) => {
      var itemBox = document.createElement('div');
      itemBox.style.cssText = "background:#f0f0f0; padding:10px; border-radius:6px; color:#333;";
      itemBox.innerHTML = `<p style="margin:0 0 5px; font-weight:bold;">${i+1}. ${f.displayName}</p>`;
      var blobUrl = URL.createObjectURL(f.blob);
      previewURLs.push(blobUrl);

      if (f.kind === 'image') {
        itemBox.innerHTML += `<img src="${blobUrl}" style="width:100%; max-height:150px; object-fit:contain; border-radius:4px;">`;
      } else if (f.kind === 'video') {
        itemBox.innerHTML += `<video src="${blobUrl}" controls playsinline preload="metadata" style="width:100%; max-height:200px; border-radius:4px;"></video>`;
      } else {
        itemBox.innerHTML += `<audio src="${blobUrl}" controls preload="metadata" style="width:100%;"></audio>`;
      }
      container.appendChild(itemBox);
    });

    container.querySelectorAll('video, audio').forEach(fixDuration);
    $('previewSheet').classList.add('on');
    setAR(false);
  }

  function fixDuration(v) {
    v.addEventListener('loadedmetadata', function () {
      if (!isFinite(v.duration)) waitForFiniteDuration(v);
    }, { once: true });
  }

  function clearPreview() {
    var container = $('localPreviewContainer');
    container.querySelectorAll('video, audio').forEach(media => {
      media.pause();
      media.removeAttribute('src');
      media.load();
    });
    container.innerHTML = '';
    previewURLs.forEach(u => URL.revokeObjectURL(u));
    previewURLs = [];
  }

  $('backToUploadBtn').onclick = function() {
    clearPreview();
    $('previewSheet').classList.remove('on');
    $('uploadSheet').classList.add('on');
  };

  $('closePreviewBtn').onclick = function() {
    clearPreview();
    $('previewSheet').classList.remove('on');
    setAR(true);
  };

  // --- Τελική επεξεργασία βίντεο (στο κρυφό procVideo) ---
  function loadProcVideo(video, url) {
    return new Promise(function (resolve, reject) {
      var t = setTimeout(function () { reject(new Error('Το βίντεο δεν φόρτωσε.')); }, 15000);
      video.onloadedmetadata = function () { clearTimeout(t); video.onloadedmetadata = null; video.onerror = null; resolve(); };
      video.onerror = function () { clearTimeout(t); video.onerror = null; reject(new Error('Σφάλμα φόρτωσης βίντεο.')); };
      video.src = url;
      video.load();
    });
  }

  async function processVideoFile(file, ranges, onProg) {
    if (!window.MediaRecorder) throw new Error('Ο browser δεν υποστηρίζει εγγραφή βίντεο.');

    var video = $('procVideo');
    video.muted = false;
    var url = URL.createObjectURL(file);
    try {
      await loadProcVideo(video, url);
      await waitForFiniteDuration(video);
      return await recordProcessedVideo(video, ranges, onProg);
    } finally {
      try { video.pause(); } catch (e) {}
      video.removeAttribute('src');
      video.load();
      URL.revokeObjectURL(url);
    }
  }

  function recordProcessedVideo(video, ranges, onProg) {
    return new Promise(function (resolve, reject) {
      var mime = [
        'video/webm;codecs=vp9,opus',
        'video/webm;codecs=vp8,opus',
        'video/mp4;codecs=avc1.42E01E,mp4a.40.2',
        'video/mp4',
        'video/webm'
      ].filter(function (t) { try { return MediaRecorder.isTypeSupported(t); } catch (e) { return false; } })[0];

      if (!mime) { reject(new Error('Ο browser δεν υποστηρίζει εγγραφή βίντεο.')); return; }

      var blurRanges = ranges.filter(r => r.blur);
      var muteRanges = ranges.filter(r => r.mute);

      var vw = video.videoWidth || 640, vh = video.videoHeight || 480;
      var k = Math.min(1, MAX_VIDEO_W / vw);
      var ow = Math.max(2, Math.round(vw * k / 2) * 2);
      var oh = Math.max(2, Math.round(vh * k / 2) * 2);

      var oCanvas = document.createElement('canvas');
      oCanvas.width = ow; oCanvas.height = oh;
      var oCtx = oCanvas.getContext('2d', { alpha: false });
      oCtx.imageSmoothingEnabled = true;

      var scratch = document.createElement('canvas');
      var tw = 24, th = Math.max(1, Math.round(tw * vh / vw));
      scratch.width = tw; scratch.height = th;
      var sctx = scratch.getContext('2d', { alpha: false });
      sctx.imageSmoothingEnabled = true;

      var pa;
      try { pa = getProcAudio(); } catch (e) { reject(new Error('Audio: ' + e.message)); return; }
      var audioCtx = pa.ctx, gainNode = pa.gain;
      var destNode = audioCtx.createMediaStreamDestination();
      gainNode.connect(destNode);
      gainNode.gain.setValueAtTime(1, audioCtx.currentTime);

      function cleanupAudio() {
        try { gainNode.disconnect(destNode); } catch (e) {}
        gainNode.gain.setValueAtTime(1, audioCtx.currentTime);
      }

      var vTracks = oCanvas.captureStream(30).getVideoTracks();
      var aTracks = destNode.stream.getAudioTracks();
      var stream = new MediaStream(vTracks.concat(aTracks));

      var rec;
      try { rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: VIDEO_BITRATE }); }
      catch (e) { cleanupAudio(); reject(new Error('MediaRecorder: ' + e.message)); return; }

      var chunks = [], running = true, finished = false, lastUI = 0;
      rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
      rec.onstop = function () {
        if (finished) return; finished = true;
        running = false;
        try { video.pause(); } catch (e) {}
        video.onended = null;
        vTracks.forEach(t => { try { t.stop(); } catch (e) {} });
        cleanupAudio();
        resolve(new Blob(chunks, { type: mime.split(';')[0] }));
      };

      function drawFrame() {
        if (inRanges(blurRanges, video.currentTime)) {
          sctx.drawImage(video, 0, 0, tw, th);
          oCtx.drawImage(scratch, 0, 0, tw, th, 0, 0, ow, oh);
        } else {
          oCtx.drawImage(video, 0, 0, ow, oh);
        }
      }

      function nextFrame(fn) {
        if (video.requestVideoFrameCallback) video.requestVideoFrameCallback(function () { fn(); });
        else requestAnimationFrame(fn);
      }

      function loop() {
        if (!running) return;
        drawFrame();
        gainNode.gain.setValueAtTime(inRanges(muteRanges, video.currentTime) ? 0 : 1, audioCtx.currentTime);

        var now = performance.now();
        if (now - lastUI > 250) {
          lastUI = now;
          if (isFinite(video.duration) && video.duration > 0 && onProg) {
            onProg(video.currentTime / video.duration * 100,
                   Math.round(video.currentTime) + 's / ' + Math.round(video.duration) + 's');
          }
        }
        nextFrame(loop);
      }

      function stopAll() { if (rec.state !== 'inactive') rec.stop(); }

      function seekToStart() {
        return new Promise(function (res) {
          var done = false, go = function () { if (!done) { done = true; res(); } };
          if (video.readyState >= 2 && video.currentTime < 0.05) { go(); return; }
          video.addEventListener('seeked', go, { once: true });
          video.currentTime = 0;
          setTimeout(go, 1200);
        });
      }

      if (onProg) onProg(0, 'προθέρμανση');

      seekToStart().then(function () {
        return Promise.resolve(video.play());
      }).then(function () {
        if (audioCtx.state === 'suspended') return audioCtx.resume();
      }).then(function () {
        var primed = 0;
        (function prime() {
          drawFrame();
          if (++primed < 4) { nextFrame(prime); return; }
          video.onended = stopAll;
          rec.start(1000);
          loop();
        })();
      }).catch(function (err) {
        running = false;
        cleanupAudio();
        reject(new Error('Δεν ξεκίνησε η αναπαραγωγή: ' + (err && err.message ? err.message : err)));
      });
    });
  }

  // --- Τελική επεξεργασία ήχου ---
  function processAudioLocal(file, mRanges) {
    return new Promise(function(resolve, reject) {
      var reader = new FileReader();
      reader.onerror = function(){ reject(new Error('Αποτυχία ανάγνωσης αρχείου.')); };
      reader.onload = async function(e) {
        try {
          var aCtx = new (window.AudioContext || window.webkitAudioContext)();
          var aBuf = await new Promise(function (res, rej) { aCtx.decodeAudioData(e.target.result, res, rej); });
          aCtx.close();

          var oCtx = new OfflineAudioContext(aBuf.numberOfChannels, aBuf.length, aBuf.sampleRate);
          var src = oCtx.createBufferSource(); src.buffer = aBuf;
          var gain = oCtx.createGain(); gain.gain.setValueAtTime(1, 0);
          mRanges.forEach(function(r){
            gain.gain.setValueAtTime(1, Math.max(0, r.s - 0.01));
            gain.gain.setValueAtTime(0, r.s);
            gain.gain.setValueAtTime(0, r.e);
            gain.gain.setValueAtTime(1, r.e + 0.01);
          });
          src.connect(gain); gain.connect(oCtx.destination); src.start(0);

          var renBuf = await oCtx.startRendering();
          var numCh = renBuf.numberOfChannels, len = renBuf.length * numCh * 2 + 44;
          var buf = new ArrayBuffer(len), view = new DataView(buf), pos = 0;
          var set16 = function(d){ view.setUint16(pos, d, true); pos += 2; };
          var set32 = function(d){ view.setUint32(pos, d, true); pos += 4; };

          set32(0x46464952); set32(len - 8); set32(0x45564157); set32(0x20746d66); set32(16); set16(1); set16(numCh);
          set32(renBuf.sampleRate); set32(renBuf.sampleRate * 2 * numCh); set16(numCh * 2); set16(16); set32(0x61746164); set32(len - pos - 4);

          var chs = [];
          for (var i = 0; i < numCh; i++) chs.push(renBuf.getChannelData(i));
          for (var offset = 0; offset < renBuf.length; offset++) {
            for (var c = 0; c < numCh; c++) {
              var smp = Math.max(-1, Math.min(1, chs[c][offset]));
              set16((smp < 0 ? smp * 32768 : smp * 32767) | 0);
            }
          }
          resolve(new Blob([buf], {type: "audio/wav"}));
        } catch(err) { reject(err); }
      };
      reader.readAsArrayBuffer(file);
    });
  }
})();
</script>
</body>
</html>
