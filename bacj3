  function drawWaveform(buffer) {
    var waveCanvas = $('audioWaveCanvas');
    var waveCtx = waveCanvas.getContext('2d');
    var dpr = window.devicePixelRatio || 1;
    var rect = waveCanvas.getBoundingClientRect();
    var width = rect.width || waveCanvas.parentElement.clientWidth || 300;
    var height = rect.height || 90;

    waveCanvas.width = width * dpr;
    waveCanvas.height = height * dpr;
    waveCtx.scale(dpr, dpr);
    waveCtx.clearRect(0, 0, width, height);

    var topOffset = 16;
    var waveHeight = height - topOffset;
    waveCtx.fillStyle = 'rgba(78, 140, 147, 0.3)';
    waveCtx.fillRect(0, topOffset + (waveHeight / 2) - 1, width, 2);
    waveCtx.fillStyle = '#F0C244';

    var data = buffer.getChannelData(0);
    var step = Math.ceil(data.length / width);
    var amp = waveHeight / 2;

    for (var i = 0; i < width; i++) {
      var min = 1.0, max = -1.0;
      var start = i * step, end = Math.min(start + step, data.length);
      for (var j = start; j < end; j++) {
        var d = data[j];
        if (d < min) min = d;
        if (d > max) max = d;
      }
      var y1 = topOffset + (1 + min) * amp;
      var y2 = topOffset + (1 + max) * amp;
      waveCtx.fillRect(i, y1, 1, Math.max(1, y2 - y1));
    }

    var duration = buffer.duration;
    if (!isFinite(duration) || duration <= 0) return;
    var interval = pickInterval(duration);
    waveCtx.fillStyle = 'rgba(242, 237, 228, 0.8)';
    waveCtx.font = '10px monospace';
    waveCtx.textBaseline = 'top';

    for (var t = 0; t <= duration; t += interval) {
      var x = (t / duration) * width;
      waveCtx.textAlign = x < 10 ? 'left' : (x > width - 15 ? 'right' : 'center');
      waveCtx.fillText(t + 's', x, 2);
      waveCtx.fillStyle = 'rgba(242, 237, 228, 0.15)';
      waveCtx.fillRect(x, topOffset - 2, 1, height - topOffset + 2);
      waveCtx.fillStyle = 'rgba(242, 237, 228, 0.8)';
    }
  }

