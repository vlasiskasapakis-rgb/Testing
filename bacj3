  var mediaRecorder = null, audioChunks = [], recTimerInterval = null, recSeconds = 0, recordingStream = null, recCancelled = false;

  $('recordAudioBtn').onclick = async function() {
    try {
      recordingStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } });
      audioChunks = [];
      recCancelled = false;

      var mimeType = '';
      ['audio/mp4', 'audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus'].some(function (t) {
        if (MediaRecorder.isTypeSupported(t)) { mimeType = t; return true; }
        return false;
      });

      mediaRecorder = new MediaRecorder(recordingStream, mimeType ? { mimeType: mimeType } : {});
      mediaRecorder.ondataavailable = function(e) { if (e.data && e.data.size > 0) audioChunks.push(e.data); };
      mediaRecorder.onstop = function() {
        if (recordingStream) { recordingStream.getTracks().forEach(t => t.stop()); recordingStream = null; }
        if (recCancelled) return;
        var finalMime = mediaRecorder.mimeType || 'audio/mp4';
        var ext = finalMime.includes('webm') ? 'webm' : (finalMime.includes('ogg') ? 'ogg' : 'm4a');
        var fileName = "ηχογράφηση_" + new Date().toISOString().slice(0,10) + "." + ext;
        var recordedFile = new File([new Blob(audioChunks, { type: finalMime })], fileName, { type: finalMime });
        $('recorderModal').classList.remove('on');
        window.currentEditIndex = -1;
        loadFileIntoEditor(recordedFile, null);
      };

      mediaRecorder.start(250);
      $('recorderModal').classList.add('on');
      recSeconds = 0;
      $('recStatusTimer').textContent = "00:00";
      recTimerInterval = setInterval(function() {
        recSeconds++;
        $('recStatusTimer').textContent = String(Math.floor(recSeconds / 60)).padStart(2, '0') + ":" + String(recSeconds % 60).padStart(2, '0');
      }, 1000);
    } catch (err) {
      alert("Δεν ήταν δυνατή η πρόσβαση στο μικρόφωνο: " + (err.message || err));
    }
  };

