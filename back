<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
<title>Διαδρομή μνήμης — Μυτιλήνη (AR & Local Editor)</title>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
<script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>
<script src="https://raw.githack.com/AR-js-org/AR.js/3.4.7/three.js/build/ar-threex-location-only.js"></script>
<script src="https://raw.githack.com/AR-js-org/AR.js/3.4.7/aframe/build/aframe-ar.js"></script>

<style>
  :root {
    --ink: #0E2A2E; --bone: #F2EDE4; --chalk: #F0C244;
    --sea: #4E8C93; --pad: 16px;
    --handle: calc(52px + env(safe-area-inset-bottom));
  }
  * { box-sizing: border-box; }
  html, body {
    width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden;
    background: var(--ink); color: var(--bone);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 17px; line-height: 1.5;
  }
  button { font: inherit; cursor: pointer; border: 0; border-radius: 2px; }
  img.labelsrc { display: none; }

  /* AR Scene - Πίσω από όλα */
  a-scene, a-scene .a-canvas { position: fixed !important; inset: 0 !important; width: 100% !important; height: 100% !important; z-index: 0; }
  body.editing a-scene, body.editing a-scene .a-canvas { visibility: hidden !important; }

  /* Βασικό UI AR */
  #gate { position: fixed; inset: 0; z-index: 40; display: flex; flex-direction: column; justify-content: flex-end; padding: 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); background: radial-gradient(120% 80% at 50% 0%, #14454B 0%, var(--ink) 70%); }
  #gate h1 { font-size: 30px; margin: 0 0 12px; }
  #gate .rule { height: 2px; width: 44px; background: var(--chalk); margin: 0 0 22px; }
  #startBtn { margin-top: 26px; width: 100%; padding: 17px; background: var(--chalk); color: var(--ink); font-size: 18px; font-weight: 600; }
  #hud { position: fixed; inset: 0; z-index: 20; pointer-events: none; display: none; }
  #hud.on { display: block; }
  #status { position: absolute; top: calc(var(--pad) + env(safe-area-inset-top)); left: var(--pad); right: var(--pad); padding: 9px 13px; background: rgba(14,42,46,.92); font-size: 14px; }

  /* Χάρτης & Compass */
  #drawer { position: fixed; left: 0; right: 0; bottom: 0; height: 52%; z-index: 15; display: flex; flex-direction: column; transform: translateY(calc(100% - var(--handle))); transition: transform .28s cubic-bezier(.32,.72,0,1); }
  #drawer.open { transform: translateY(0); }
  #handle { flex: none; height: var(--handle); width: 100%; display: flex; align-items: center; gap: 11px; padding: 0 var(--pad); background: var(--ink); color: var(--bone); border-top: 3px solid var(--chalk); touch-action: none; pointer-events: auto; }
  #handle .grip { width: 34px; height: 4px; border-radius: 2px; background: rgba(242,237,228,.45); flex: none; }
  #handle .lbl { font-size: 15px; font-weight: 600; }
  #map { flex: 1; background: #0A1F22; pointer-events: auto; }
  .leaflet-container { background: #0A1F22; font-family: inherit; }
  .map-cluster-dot { background: var(--sea); color: var(--bone); border: 3px solid var(--ink); border-radius: 50%; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  #compass { position: absolute; top: calc(var(--handle) + 10px); right: 10px; z-index: 500; width: 54px; height: 54px; border-radius: 50%; background: rgba(14,42,46,.92); color: var(--bone); display: flex; align-items: center; justify-content: center; }
  #compass .needle { position: absolute; inset: 0; transform-origin: 50% 50%; }
  #compass .needle::before { content: ''; position: absolute; left: 50%; top: 8px; transform: translateX(-50%); width: 0; height: 0; border-left: 7px solid transparent; border-right: 7px solid transparent; border-bottom: 19px solid var(--chalk); }
  #compass .needle::after { content: ''; position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); width: 0; height: 0; border-left: 7px solid transparent; border-right: 7px solid transparent; border-top: 19px solid rgba(242,237,228,.28); }

  /* Πλησιέστερο Σημείο */
  #nearest { position: absolute; left: var(--pad); right: var(--pad); bottom: calc(var(--handle) + var(--pad)); transition: bottom .28s; pointer-events: auto; display: none; width: calc(100% - var(--pad)*2); text-align: left; padding: 15px 17px; background: var(--bone); color: var(--ink); border-left: 5px solid var(--chalk); }
  #nearest.on { display: block; }
  body.drawer-open #nearest { bottom: calc(52% + var(--pad)); }
  #nearest .dist { display: block; font-size: 14px; color: var(--sea); margin-bottom: 2px; }
  #nearest .name { display: block; font-size: 19px; font-weight: 600; }

  /* Markers */
  .me-wrap { position: relative; width: 56px; height: 56px; }
  .me-rot  { position: absolute; inset: 0; transform-origin: 50% 50%; }
  .me-cone { position: absolute; left: 50%; bottom: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 17px solid transparent; border-right: 17px solid transparent; border-top: 30px solid rgba(240, 194, 68, 0.88); }
  .me-rot.unknown .me-cone { display: none; }
  .me-dot { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 18px; height: 18px; border-radius: 50%; background: var(--chalk); border: 3px solid var(--ink); }
  .poi-dot { width: 13px; height: 13px; border-radius: 50%; background: var(--bone); border: 3px solid var(--chalk); }

  /* Info Sheet */
  #infoSheet { position: fixed; inset: 0; z-index: 30; display: none; flex-direction: column; justify-content: flex-end; background: rgba(14,42,46,.55); pointer-events: auto; }
  #infoSheet.on { display: flex; }
  .sheet-inner { background: var(--bone); color: var(--ink); padding: 26px var(--pad) calc(26px + env(safe-area-inset-bottom)); max-height: 95%; overflow-y: auto; border-radius: 16px 16px 0 0; }
  #closeInfoBtn { padding: 14px 22px; background: var(--ink); color: var(--bone); font-size: 16px; margin-top: 10px;}

  /* --- Εργαλεία Upload & Edit --- */
  #addBtn { position: fixed; bottom: calc(var(--handle) + var(--pad) + 70px); right: var(--pad); z-index: 25; width: 56px; height: 56px; border-radius: 50%; background: var(--chalk); color: var(--ink); font-size: 32px; font-weight: 300; display: none; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.4); pointer-events: auto; }
  #addBtn.on { display: flex; }
  body.drawer-open #addBtn { bottom: calc(52% + var(--pad)); }

  .edit-sheet { position: fixed; inset: 0; z-index: 60; display: none; flex-direction: column; justify-content: flex-end; background: rgba(14,42,46,.9); pointer-events: auto; }
  .edit-sheet.on { display: flex; }
  .edit-sheet .sheet-inner { max-height: 95vh; overflow-y: auto; }

  .input-group { margin-bottom: 16px; }
  .input-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 4px; color: var(--sea); }
  .input-group input[type="text"] { width: 100%; padding: 10px; border: 2px solid #ccc; border-radius: 6px; font-size: 16px; }
  .btn-row { display: flex; gap: 10px; margin-top: 20px; }
  .btn-row button { flex: 1; padding: 14px; font-size: 16px; font-weight: 600; border-radius: 6px; }
  .btn-primary { background: var(--sea); color: var(--bone); }
  .btn-secondary { background: #ccc; color: var(--ink); }

  #mediaList { margin-bottom: 15px; }
  .media-list-item { background: #e0e0e0; padding: 10px; margin-bottom: 6px; border-radius: 6px; font-size: 14px; color: var(--ink); display: flex; justify-content: space-between; align-items: center; }
  .delete-media-btn { background: #d9534f; color: white; border: none; padding: 5px 10px; border-radius: 4px; font-size: 12px; cursor: pointer; }
  .edit-media-btn { background: var(--sea); color: white; border: none; padding: 5px 10px; border-radius: 4px; font-size: 12px; cursor: pointer; margin-left: 5px; }

  /* Editor Canvas & Box */
  .editor-box { position: relative; width: 100%; background: #000; border-radius: 6px; overflow: hidden; margin-bottom: 15px; display: none; touch-action: none; }
  #imageCanvas { width: 100%; display: block; touch-action: none; }
  #videoContainer { position: relative; width: 100%; }
  #videoPreview { width: 100%; display: block; }
  
  /* Timeline Σχεδίαση */
  #videoTimeline { position: relative; width: 100%; height: 12px; background: #ddd; border-radius: 3px; margin: 8px 0 14px; overflow: hidden; }
  .timeline-block { position: absolute; top: 0; height: 100%; background: rgba(78, 140, 147, 0.85); border-left: 1px solid #fff; border-right: 1px solid #fff; }
  .timeline-block.blur { background: rgba(240, 194, 68, 0.88); }

  .range-item { background: #fff; border: 1px solid #ccc; border-radius: 6px; padding: 10px; margin-bottom: 8px; color: #333; }
  .range-item .rr { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 14px; }
  .range-item .rr + .rr { margin-top: 8px; }
  .range-item input[type="number"] { width: 72px; padding: 6px; border-radius: 4px; border: 1px solid #ccc; font-size: 15px; }
  .range-item label { display: flex; align-items: center; gap: 5px; font-weight: 600; color: var(--ink); }
  .range-item input[type="checkbox"] { width: 20px; height: 20px; }
  .nowbtn { background: var(--sea); color: var(--bone); padding: 6px 9px; font-size: 12px; border-radius: 4px; }
  .delrow { margin-left: auto; background: #d9534f; color: #fff; padding: 6px 10px; font-size: 13px; border-radius: 4px; }
  #vTimeNow { font-family: monospace; font-size: 13px; color: var(--sea); margin: 6px 0 10px; }

  .mute-item { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; background: #fff; padding: 8px; border-radius: 4px; border: 1px solid #ccc; font-size: 14px; color: #333; }
  .mute-item input[type="number"] { width: 68px; padding: 5px; border-radius: 4px; border: 1px solid #ccc; }

  #processingOverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.88); color: white; display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 200; text-align: center; padding: 20px;}
  #procBar { width: 80%; max-width: 320px; height: 8px; background: rgba(255,255,255,.2); border-radius: 4px; margin-top: 16px; overflow: hidden; }
  #procBarFill { height: 100%; width: 0%; background: var(--chalk); transition: width .2s linear; }
</style>
</head>
<body>

<!-- Εκκίνηση -->
<div id="gate">
  <h1>Διαδρομή μνήμης, κέντρο Μυτιλήνης</h1>
  <div class="rule"></div>
  <p>Χρειάζεται κάμερα, τοποθεσία και αισθητήρες κίνησης. Δούλεψε σε ανοιχτό χώρο.</p>
  <button id="startBtn">Ξεκίνα τη διαδρομή</button>
</div>

<!-- AR HUD & Κουμπιά -->
<div id="hud">
  <div id="status">Αναμονή για στίγμα…</div>
  <button id="nearest"><span class="dist"></span><span class="name"></span></button>
</div>

<!-- Κουμπί Νέας Ιστορίας -->
<button id="addBtn" aria-label="Προσθήκη">+</button>

<!-- Drawer Χάρτη -->
<div id="drawer">
  <button id="handle"><span class="grip"></span><span class="lbl">Χάρτης</span></button>
  <div id="map"><div id="compass"><span class="needle"></span><span class="deg">—</span></div></div>
</div>

<!-- Προβολή Υπάρχουσας Ιστορίας -->
<div id="infoSheet" class="edit-sheet">
  <div class="sheet-inner">
    <h2 id="sheetTitle"></h2>
    <p id="sheetSub" style="color:var(--sea); margin-top:-10px; font-size:14px;"></p>
    <p id="sheetBody"></p>
    <button id="closeInfoBtn">Κλείσιμο</button>
  </div>
</div>

<!-- 1. Κεντρικό Μενού Upload -->
<div id="uploadSheet" class="edit-sheet">
  <div class="sheet-inner">
    <h2>Νέα Ιστορία</h2>
    <div class="input-group">
      <label>Τοποθεσία (Κλειδωμένη στο στίγμα σου)</label>
      <div id="locDisplay" style="font-family:monospace; padding:8px; background:#e0e0e0; border-radius:4px; color:#333;">Αναμονή...</div>
    </div>
    <div class="input-group">
      <label>Τίτλος Ιστορίας</label>
      <input type="text" id="storyTitle" placeholder="π.χ. Η παλιά αγορά">
    </div>

    <div class="input-group">
      <label>Έτοιμα Πολυμέσα</label>
      <div id="mediaList">
        <p style="font-size:13px; color:#666; margin:0;">Δεν έχεις προσθέσει αρχεία ακόμα.</p>
      </div>
      <input type="file" id="singleFileInput" accept="image/*,video/*,audio/*" style="display:none;">
      <button class="btn-secondary" id="triggerFileBtn" style="width:100%; padding:12px; margin-top:5px; border: 2px dashed #999;">+ Προσθήκη Αρχείου</button>
    </div>

    <div class="btn-row">
      <button class="btn-secondary" onclick="cancelStory()">Ακύρωση</button>
      <button class="btn-primary" id="finishStoryBtn">Ολοκλήρωση Ιστορίας</button>
    </div>
  </div>
</div>

<!-- 2. Editor Αρχείου -->
<div id="editorSheet" class="edit-sheet">
  <div class="sheet-inner" style="position: relative;">
    <h2 id="editorTitle">Επεξεργασία Αρχείου</h2>
    <p id="editorFilename" style="font-size:13px; color:var(--sea); margin-top:-10px; margin-bottom:15px;">αρχείο.jpg</p>

    <!-- Editor Εικόνας (Blur) -->
    <div id="imageEditor" class="editor-box">
      <canvas id="imageCanvas"></canvas>
      <div style="position:absolute; top:10px; left:10px; background:rgba(0,0,0,0.6); color:white; padding:4px 8px; font-size:12px; border-radius:4px; pointer-events:none;">Σύρε το δάχτυλο για θόλωμα</div>
      <button id="undoBlurBtn" style="position:absolute; top:10px; right:10px; background:var(--chalk); color:var(--ink); padding:6px 12px; font-size:13px; font-weight:bold; border-radius:4px; z-index:10; pointer-events:auto;">↩ Αναίρεση</button>
    </div>

    <!-- Editor Βίντεο (Blur Area, Mute Points & Visual Timeline) -->
    <div id="videoEditor" class="editor-box" style="background:#fff;">
      <div id="videoContainer">
        <video id="videoPreview" controls playsinline preload="metadata"></video>
      </div>
      <!-- Οπτική Μπάρα Timeline -->
      <div id="videoTimeline" title="Οπτική προεπισκόπηση διαστημάτων"></div>
      
      <div id="vTimeNow">Τρέχον σημείο: 0.0s</div>

      <label style="font-size:14px; font-weight:600; color:var(--sea); display:block;">Διαστήματα επεξεργασίας (Stamps)</label>
      <p style="font-size:12px; color:#666; margin:4px 0 10px;">Τα σημεία εμφανίζονται οπτικά στη μπάρα παραπάνω.</p>
      <div id="videoRangeList"></div>
      <button id="addRangeBtn" style="padding:10px 14px; background:var(--chalk); color:var(--ink); font-size:14px; font-weight:600; border-radius:4px;">+ Προσθήκη διαστήματος</button>
    </div>

    <!-- Editor Ήχου (Mute) -->
    <div id="audioEditor" style="display:none; width:100%; margin-bottom:15px;">
      <audio id="audioPreview" controls style="width:100%; margin-bottom:10px;"></audio>
      <label style="font-size:14px; font-weight:600; color:var(--sea);">Σημεία Σίγασης (Stamps):</label>
      <p style="font-size:12px; color:#666; margin:4px 0 10px;">Όρισε τα σημεία που θέλεις να σιγάσεις:</p>
      <div id="audioMuteList"></div>
      <button id="addAudioRangeBtn" style="padding:10px 14px; background:var(--chalk); color:var(--ink); font-size:14px; font-weight:600; border-radius:4px;">+ Προσθήκη σημείου σίγασης</button>
    </div>

    <div class="btn-row">
      <button class="btn-secondary" id="cancelSingleBtn">Άκυρο Αρχείου</button>
      <button class="btn-primary" id="saveFileBtn">Αποθήκευση</button>
    </div>
  </div>
</div>

<!-- Overlay επεξεργασίας -->
<div id="processingOverlay">
  <h3 style="margin:0 0 10px;">Γίνεται επεξεργασία…</h3>
  <p id="procMsg" style="font-size:14px; margin:0;">Παρακαλώ περιμένετε…</p>
  <div id="procBar"><div id="procBarFill"></div></div>
  <p style="font-size:12px; opacity:.7; margin-top:14px;">Εφαρμογή όλων των ρυθμίσεων. Μην κλειδώσεις την οθόνη.</p>
</div>

<!-- 3. Μενού Τοπικής Προβολής Αρχείων -->
<div id="previewSheet" class="edit-sheet">
  <div class="sheet-inner">
    <h2>Τα Αρχεία σου (Τοπική Προβολή)</h2>
    <p style="font-size:13px; color:var(--sea); margin-top:-10px;">Έλεγξε τα επεξεργασμένα αρχεία σου:</p>

    <div id="localPreviewContainer" style="display:flex; flex-direction:column; gap:15px; margin-bottom:20px;"></div>

    <button class="btn-primary" id="closePreviewBtn" style="width:100%;">Κλείσιμο Προβολής</button>
  </div>
</div>

<script>
(function () {
  'use strict';
  var $ = function(id) { return document.getElementById(id); };

  // ==========================================
  // 1. AR & ΧΑΡΤΗΣ ΛΟΓΙΚΗ
  // ==========================================
  var STORIES = [
    { id: 'therapon', title: 'Άγιος Θεράπων', subtitle: 'Ερμού', lat: 39.105132, lon: 26.554781, radius: 35, text: 'Η μεγαλύτερη εκκλησία της πόλης.' },
    { id: 'sapfous', title: 'Πλατεία Σαπφούς', subtitle: 'Παραλιακή', lat: 39.106641, lon: 26.557426, radius: 40, text: 'Η κεντρική πλατεία της Μυτιλήνης.' }
  ];

  var SMOOTHING = 0.1, MIN_DIST = 2, Y_OFF = 1.2;
  var AR_CLUSTERS = [], CLUSTER_RADIUS_M = 50, CLUSTER_REVEAL_M = 80;
  var me = null, map = null, meMarker = null, accCircle = null, followMe = true;
  window.currentHeading = null;

  var arPaused = false;
  function setAR(active) {
    var sc = document.querySelector('a-scene');
    if (!sc) return;
    if (!active && !arPaused) { try { sc.pause(); } catch(e){} arPaused = true; document.body.classList.add('editing'); }
    else if (active && arPaused) { try { sc.play(); } catch(e){} arPaused = false; document.body.classList.remove('editing'); }
  }

  function distanceMetres(lat1, lon1, lat2, lon2) {
    var R = 6371000, rad = function(d) { return d * Math.PI / 180; };
    var a = Math.sin(rad(lat2 - lat1)/2) * Math.sin(rad(lat2 - lat1)/2) + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(rad(lon2 - lon1)/2) * Math.sin(rad(lon2 - lon1)/2);
    return 2 * R * Math.asin(Math.sqrt(a));
  }

  var _camPos = new THREE.Vector3();
  AFRAME.registerComponent('billboard', {
    tick: function () {
      var cam = this.el.sceneEl && this.el.sceneEl.camera;
      if (!cam) return;
      cam.getWorldPosition(_camPos);
      var o = this.el.object3D;
      o.lookAt(_camPos.x, o.position.y, _camPos.z);
    }
  });

  var _cameraDir = new THREE.Vector3();
  AFRAME.registerComponent('hud-compass', {
    tick: function () {
      var cam = this.el.sceneEl && this.el.sceneEl.camera;
      if (!cam) return;
      cam.getWorldDirection(_cameraDir);
      var h = Math.atan2(_cameraDir.x, -_cameraDir.z) * 180 / Math.PI;
      if (h < 0) h += 360;
      window.currentHeading = h;
      if (this.displayHeading === undefined) this.displayHeading = h;
      var diff = h - (this.displayHeading % 360);
      if (diff > 180) diff -= 360; else if (diff < -180) diff += 360;
      this.displayHeading += diff;

      var needle = document.querySelector('#compass .needle');
      var degOut = document.querySelector('#compass .deg');
      if (needle) {
        needle.style.transform = 'rotate(' + (-this.displayHeading) + 'deg)';
        degOut.textContent = Math.round(h) + '°';
      }
      applyHeadingToDot();
    }
  });

  function makeLabelImage(title, subtitle, isCluster) {
    var c = document.createElement('canvas'); c.width = 1800; c.height = 600; var g = c.getContext('2d'); g.scale(2,2);
    g.fillStyle = isCluster ? 'rgba(14,42,46,0.95)' : 'rgba(14,42,46,0.90)'; g.fillRect(0,0,900,300);
    g.fillStyle = isCluster ? '#4E8C93' : '#F0C244'; g.fillRect(0,0,16,300);
    g.fillStyle = '#F2EDE4'; g.font = '600 82px sans-serif'; g.textBaseline = 'middle'; g.fillText(title, 50, 120);
    g.fillStyle = '#8FC0C4'; g.font = '46px sans-serif'; g.fillText(subtitle, 50, 200);
    var img = document.createElement('img'); img.id = 'img-' + Math.random().toString(36).substr(2,9);
    img.src = c.toDataURL(); img.className = 'labelsrc'; document.body.appendChild(img);
    return img.id;
  }

  function prepareARClusters() {
    var assigned = {};
    STORIES.forEach((s, i) => {
      if(assigned[i]) return;
      var c = { id: 'c-'+i, stories: [s], lat: s.lat, lon: s.lon }; assigned[i] = true;
      STORIES.forEach((s2, j) => {
        if(i!==j && !assigned[j] && distanceMetres(s.lat, s.lon, s2.lat, s2.lon) < CLUSTER_RADIUS_M) {
          c.stories.push(s2); assigned[j] = true;
        }
      });
      if(c.stories.length > 1) {
        c.lat = c.stories.reduce((sum,st)=>sum+st.lat,0)/c.stories.length;
        c.lon = c.stories.reduce((sum,st)=>sum+st.lon,0)/c.stories.length;
        AR_CLUSTERS.push(c);
      }
    });
  }

  function buildScene() {
    prepareARClusters();
    var parts = [];
