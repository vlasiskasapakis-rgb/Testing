    if(file.type.startsWith('image/')) {
      $('imageEditor').style.display = 'block';
      imageHistory = [];
      imgObj = new Image();
      imgObj.onload = () => {
        var k = Math.min(1, MAX_IMAGE_W / imgObj.width);
        canvas.width = Math.round(imgObj.width * k);
        canvas.height = Math.round(imgObj.height * k);
        ctx.drawImage(imgObj, 0, 0, canvas.width, canvas.height);

        blurSrc.width = canvas.width; blurSrc.height = canvas.height;
        var bctx = blurSrc.getContext('2d');
        bctx.filter = 'blur(14px)';
        bctx.drawImage(canvas, 0, 0);
        bctx.filter = 'none';
      };
      imgObj.src = currentObjectURL;
    }
    else if(file.type.startsWith('video/')) {
      $('videoEditor').style.display = 'block';
      var vid = $('videoPreview'); 
      $('vTimeNow').textContent = 'Φόρτωση βίντεο...';
