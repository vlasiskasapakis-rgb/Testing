  // --- Επεξεργαστής Βίντεο ---
  function processVideoLocal(file) {
    return new Promise(function (resolve, reject) {
      setAR(false);

      var video = $('videoPreview');
      var ranges = readVideoRanges();

      if (ranges.length === 0) { 
        setAR(true); 
        resolve(file); 
        return; 
      }

      if (!window.MediaRecorder) { 
        setAR(true);
        resolve(file); 
        return; 
      }
      
      var mime = [
        'video/webm;codecs=vp9,opus',
        'video/webm;codecs=vp8,opus',
        'video/mp4;codecs=avc1.42E01E,mp4a.40.2', 
        'video/mp4',
        'video/webm'
      ].filter(function (t) { try { return MediaRecorder.isTypeSupported(t); } catch (e) { return false; } })[0];
      
      if (!mime) { 
        setAR(true);
        reject(new Error('Ο browser δεν υποστηρίζει εγγραφή βίντεο.')); 
        return; 
      }

      var blurRanges = ranges.filter(function (r) { return r.blur; });
      var muteRanges = ranges.filter(function (r) { return r.mute; });

      var vw = video.videoWidth || 640, vh = video.videoHeight || 480;
      var k = Math.min(1, MAX_VIDEO_W / vw);
      var ow = Math.max(2, Math.round(vw * k / 2) * 2);
      var oh = Math.max(2, Math.round(vh * k / 2) * 2);

      var oCanvas = document.createElement('canvas');
      oCanvas.width = ow; oCanvas.height = oh;
      var oCtx = oCanvas.getContext('2d', { alpha: false });
      oCtx.imageSmoothingEnabled = true;

      var scratch = document.createElement('canvas');
      var tw = 24, th = Math.max(1, Math.round(tw * vh / vw));
      scratch.width = tw; scratch.height = th;
      var sctx = scratch.getContext('2d', { alpha: false });
      sctx.imageSmoothingEnabled = true;

      var g = null;
      try { g = videoAudioGraph(); g.gain.gain.cancelScheduledValues(0); g.gain.gain.setValueAtTime(1, g.ctx.currentTime); }
      catch (e) { g = null; }

      var vTracks = oCanvas.captureStream(30).getVideoTracks();
      var aTracks = (g && g.dest.stream.getAudioTracks()) || [];
      var stream = new MediaStream(vTracks.concat(aTracks));

      var rec;
      try { rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: VIDEO_BITRATE }); }
      catch (e) { 
        setAR(true);
        reject(new Error('MediaRecorder: ' + e.message)); 
        return; 
      }

      var chunks = [], running = true, finished = false, lastUI = 0;
      rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
      
      rec.onstop = function () {
        if (finished) return; finished = true;
        running = false;
        try { video.pause(); } catch (e) {}
        video.onended = null;
        if (g) { g.gain.gain.cancelScheduledValues(0); g.gain.gain.setValueAtTime(1, g.ctx.currentTime); }
        
        setAR(true);
        resolve(new Blob(chunks, { type: mime.split(';')[0] }));
      };

      function drawFrame() {
        var t = video.currentTime, blurNow = false;
        for (var i = 0; i < blurRanges.length; i++) {
          if (t >= blurRanges[i].s && t < blurRanges[i].e) { blurNow = true; break; }
        }
        if (blurNow) {
          sctx.drawImage(video, 0, 0, tw, th);
          oCtx.drawImage(scratch, 0, 0, tw, th, 0, 0, ow, oh);
        } else {
          oCtx.drawImage(video, 0, 0, ow, oh);
        }
      }

      function nextFrame(fn) {
        if (video.requestVideoFrameCallback) video.requestVideoFrameCallback(function () { fn(); });
        else requestAnimationFrame(fn);
      }

      function loop() {
        if (!running) return;
        drawFrame();
        var now = performance.now();
        if (now - lastUI > 250) {  
          lastUI = now;
          if (video.duration && isFinite(video.duration)) {
            showProgress(true, 'Εγγραφή: ' + Math.round(video.currentTime) + 's / ' + Math.round(video.duration) + 's',
                         video.currentTime / video.duration * 100);
          }
        }
        nextFrame(loop);
      }

      function stopAll() { if (rec.state !== 'inactive') rec.stop(); }

      function seekToStart() {
        return new Promise(function (res) {
          var done = false, go = function () { if (!done) { done = true; res(); } };
          if (video.readyState >= 2 && video.currentTime < 0.05) { go(); return; }
          video.addEventListener('seeked', go, { once: true });
          video.currentTime = 0;
          setTimeout(go, 1200);
        });
      }

      showProgress(true, 'Προθέρμανση…', 0);

      seekToStart().then(function () {
        drawFrame();                            
        return Promise.resolve(video.play());
      }).then(function () {
        if (g && g.ctx.state === 'suspended') return g.ctx.resume();
      }).then(function () {
        var primed = 0;
        (function prime() {
          drawFrame();
          if (++primed < 4) { nextFrame(prime); return; }

          if (g && muteRanges.length) {
            var t0 = g.ctx.currentTime - video.currentTime;   
            var gv = g.gain.gain;
            gv.cancelScheduledValues(0);
            gv.setValueAtTime(1, g.ctx.currentTime);
            muteRanges.forEach(function (r) {
              gv.setValueAtTime(0, Math.max(g.ctx.currentTime, t0 + r.s));
              gv.setValueAtTime(1, t0 + r.e);
            });
          }

          video.onended = stopAll;
          rec.start(1000);
          loop();
        })();
      }).catch(function (err) {
        running = false;
        setAR(true); 
        reject(new Error('Δεν ξεκίνησε η αναπαραγωγή: ' + (err && err.message ? err.message : err)));
      });
    });
  }

  // --- Επεξεργαστής Ήχου ---
  function processAudioLocal(file) {
    return new Promise(function(resolve, reject) {
      var reader = new FileReader();
      reader.onerror = function(){ reject(new Error('Αποτυχία ανάγνωσης αρχείου.')); };
      reader.onload = async function(e) {
        try {
          var aCtx = new (window.AudioContext || window.webkitAudioContext)();
          var aBuf = await aCtx.decodeAudioData(e.target.result);
          aCtx.close();

          var mRanges = [];
          document.querySelectorAll('#audioMuteList .mute-item').forEach(function(el) {
            var s = parseFloat(el.querySelector('.mute-start').value), end = parseFloat(el.querySelector('.mute-end').value);
            if(!isNaN(s) && !isNaN(end) && end>s) mRanges.push({s:s, e:end});
          });

          var oCtx = new OfflineAudioContext(aBuf.numberOfChannels, aBuf.length, aBuf.sampleRate);
          var src = oCtx.createBufferSource(); src.buffer = aBuf;
          var gain = oCtx.createGain(); gain.gain.setValueAtTime(1, 0);
          mRanges.forEach(function(r){ gain.gain.setValueAtTime(1, Math.max(0, r.s-0.01)); gain.gain.setValueAtTime(0, r.s); gain.gain.setValueAtTime(0, r.e); gain.gain.setValueAtTime(1, r.e+0.01); });
          src.connect(gain); gain.connect(oCtx.destination); src.start(0);

          var renBuf = await oCtx.startRendering();
          var numCh = renBuf.numberOfChannels, len = renBuf.length*numCh*2+44, buf = new ArrayBuffer(len), view = new DataView(buf), pos=0;
          var set16 = function(d){ view.setUint16(pos, d, true); pos+=2; }, set32 = function(d){ view.setUint32(pos, d, true); pos+=4; };

          set32(0x46464952); set32(len-8); set32(0x45564157); set32(0x20746d66); set32(16); set16(1); set16(numCh);
          set32(renBuf.sampleRate); set32(renBuf.sampleRate*2*numCh); set16(numCh*2); set16(16); set32(0x61746164); set32(len-pos-4);

          var chs = []; for(var i=0; i<numCh; i++) chs.push(renBuf.getChannelData(i));
          for(var offset=0; offset<renBuf.length; offset++) {
            for(var c=0; c<numCh; c++) {
              var smp = Math.max(-1, Math.min(1, chs[c][offset]));
              set16((smp<0 ? smp*32768 : smp*32767)|0);
            }
          }
          resolve(new Blob([buf], {type: "audio/wav"}));
        } catch(err) { reject(err); }
      };
      reader.readAsArrayBuffer(file);
    });
  }
})();
</script>
