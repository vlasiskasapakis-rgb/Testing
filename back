  function updateMap() {
    if(!map || !me) return;
    var ll = [me.lat, me.lon];
    if(!meMarker) {
      meMarker = L.marker(ll, { icon: L.divIcon({className: '', html: '<div class="me-wrap"><div class="me-rot unknown"><div class="me-cone"></div><div class="me-dot"></div></div></div>', iconSize: [56, 56], iconAnchor: [28, 28]}), zIndexOffset: 1000 }).addTo(map);
      accCircle = L.circle(ll, {radius: me.accuracy||0, color: '#F0C244'}).addTo(map);
    } else {
      meMarker.setLatLng(ll); accCircle.setLatLng(ll).setRadius(me.accuracy||0);
    }
    if(followMe) map.setView(ll, map.getZoom(), {animate: false});
  }

  var cachedRot = null, displayMapHeading = 0;
  function applyHeadingToDot() {
    if(!meMarker || window.currentHeading === null) return;
    if(!cachedRot) { var elm = meMarker.getElement(); if(elm) cachedRot = elm.querySelector('.me-rot'); }
    if(!cachedRot) return;
    cachedRot.classList.remove('unknown');
    var diff = window.currentHeading - (displayMapHeading % 360);
    if(diff > 180) diff -= 360; else if(diff < -180) diff += 360;
    displayMapHeading += diff;
    cachedRot.style.transform = `rotate(${displayMapHeading}deg)`;
  }

