  function readVideoRanges() {
    var out = [];
    document.querySelectorAll('#videoRangeList .range-item').forEach(function (row) {
      var s = parseFloat(row.querySelector('.r-start').value);
      var e = parseFloat(row.querySelector('.r-end').value);
      if (isNaN(s) || isNaN(e) || e <= s) return;
      var mute = row.querySelector('.r-mute').checked;
      var blur = row.querySelector('.r-blur').checked;
      if (!mute && !blur) return;
      out.push({ s: s, e: e, mute: mute, blur: blur });
    });
    return out;
  }

