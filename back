  var MAX_HISTORY = 15;

  var vContainer = $('videoContainer');

  var _actx = null, _vSrc = null, _vGain = null, _vDest = null;
  function videoAudioGraph() {
    var video = $('videoPreview');
    if (!_actx) _actx = new (window.AudioContext || window.webkitAudioContext)();
    if (!_vSrc) {
      _vSrc = _actx.createMediaElementSource(video);
      _vGain = _actx.createGain();
      _vDest = _actx.createMediaStreamDestination();
      _vSrc.connect(_vGain);
      _vGain.connect(_vDest);
      _vGain.connect(_actx.destination);
    }
    return { ctx: _actx, gain: _vGain, dest: _vDest };
  }

  function showProgress(on, msg, pct) {
    $('processingOverlay').style.display = on ? 'flex' : 'none';
