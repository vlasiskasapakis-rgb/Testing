  function getMousePos(e) {
    var rect = canvas.getBoundingClientRect(), scaleX = canvas.width / rect.width, scaleY = canvas.height / rect.height;
    var cX = e.touches ? e.touches[0].clientX : e.clientX, cY = e.touches ? e.touches[0].clientY : e.clientY;
    return { x: (cX - rect.left)*scaleX, y: (cY - rect.top)*scaleY };
  }
  function drawBlur(pos) {
    var r = Math.max(24, canvas.width * 0.05);
    ctx.save();
    ctx.beginPath(); ctx.arc(pos.x, pos.y, r, 0, Math.PI*2); ctx.clip();
    ctx.drawImage(blurSrc, 0, 0);
    ctx.restore();
  }
  canvas.onpointerdown = e => {
    isDrawing = true;
    imageHistory.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
    if (imageHistory.length > MAX_HISTORY) imageHistory.shift();
    drawBlur(getMousePos(e));
    canvas.setPointerCapture(e.pointerId);
  };
  canvas.onpointermove = e => { if(isDrawing) drawBlur(getMousePos(e)); };
  canvas.onpointerup = () => isDrawing = false;
  canvas.onpointercancel = () => isDrawing = false;

  $('undoBlurBtn').onclick = () => {
    if (imageHistory.length > 0) ctx.putImageData(imageHistory.pop(), 0, 0);
  };

