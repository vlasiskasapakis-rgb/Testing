  function updateARLabels() {
    if(!me) return;
    AR_CLUSTERS.forEach(c => {
      var el = document.getElementById(c.id); if(!el) return;
      var d = distanceMetres(me.lat, me.lon, c.lat, c.lon);
      if(d < CLUSTER_REVEAL_M) el.setAttribute('visible', 'false');
      else { el.setAttribute('visible', 'true'); var k = Math.max(d, 25)*0.09; el.setAttribute('scale', k+' '+k+' 1'); }
    });
    STORIES.forEach(s => {
      var el = document.querySelector(`.poi[data-id="${s.id}"]`); if(!el) return;
      var parent = AR_CLUSTERS.find(c => c.stories.includes(s));
      if(parent && distanceMetres(me.lat, me.lon, parent.lat, parent.lon) >= CLUSTER_REVEAL_M) { el.setAttribute('visible', 'false'); return; }
      el.setAttribute('visible', 'true');
      var k = Math.max(distanceMetres(me.lat, me.lon, s.lat, s.lon), 25)*0.09; el.setAttribute('scale', k+' '+k+' 1');
    });
  }

  function initMap() {
    map = L.map('map', {zoomControl: true, attributionControl: false}).setView([STORIES[0].lat, STORIES[0].lon], 16);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom: 19}).addTo(map);
    var markers = L.markerClusterGroup({ maxClusterRadius: 40, iconCreateFunction: c => L.divIcon({html: c.getChildCount(), className: 'map-cluster-dot', iconSize: [32, 32]}) });
    STORIES.forEach(s => {
      var m = L.marker([s.lat, s.lon], { icon: L.divIcon({html: '<div class="poi-dot"></div>', iconSize: [13, 13]}) }).on('click', () => {
        $('sheetTitle').textContent = s.title; $('sheetSub').textContent = s.subtitle; $('sheetBody').textContent = s.text;
        $('infoSheet').classList.add('on');
      });
      markers.addLayer(m);
    });
    map.addLayer(markers);
    map.on('dragstart', () => followMe = false);
